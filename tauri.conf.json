{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restro Pro",
  "version": "1.0.0",
  "identifier": "com.restropro.pos",
  "build": {
    "frontendDist": "restropro-lite.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Restro Pro",
        "url": "app://localhost/index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/logo.png"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBQ0IyQUE5MEVBRUJGMjYKUldRbXY2NE9xU3JMeXVqenNRU2k2bXFZRDhZWnN5MVlQNUJnb0tFcEVxVWRkbWx6M2lkeGsrS2oK",
      "endpoints": [
        "https://github.com/osamamalikawan/restropro-windows-lite/releases/latest/download/shell-latest.json"
      ]
    }
  }
}