{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window, including remote-origin access to the printing commands",
  "windows": ["main"],
  "remote": {
    "urls": ["app://*"]
  },
  "permissions": [
    "core:default",
    { "identifier": "core:app:default" },
    "allow-print-raw",
    "allow-test-printer-connection",
    "allow-list-windows-printers",
    "allow-print-raw-windows",
    "allow-list-serial-ports",
    "allow-check-serial-port",
    "allow-print-raw-serial",
    "allow-list-usb-printers",
    "allow-print-raw-usb",
    "allow-secure-set",
    "allow-secure-get",
    "allow-secure-delete",
    "allow-get-device-info",
    "allow-get-cached-staff-list",
    "allow-verify-staff-pin",
    "allow-activate-device",
    "allow-get-local-session",
    "allow-staff-logout",
    "allow-deactivate-device",
    "allow-sync-now",
    "allow-get-sync-status",
    "allow-get-cached-data",
    "allow-search-local-customers",
    "allow-create-local-sale",
    "allow-api-request",
    "allow-check-online",
    "process:allow-restart",
    "allow-check-for-shell-update",
    "allow-get-shell-update-status",
    "allow-install-shell-update"
  ]
}